@using ClinicPatientVisitMonitoringSystem.Models
@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_Layout";
}
<div class="auth-shell">
    <div class="auth-visual">
        <div class="auth-visual-content">
            <div class="auth-visual-logo">
                <img src="~/images/logo.png" alt="Clinic Monitoring System logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='grid'" />
                <div class="brand-mark-fallback-icon" style="display:none"><i class="bi bi-plus-lg"></i></div>
            </div>
            <span class="auth-visual-eyebrow"><i class="bi bi-shield-check"></i> Front desk workspace</span>
            <h2>Every patient visit, tracked in one place.</h2>
            <p>Sign in to manage today's queue, register new visits, and keep your reception desk running smoothly.</p>
            <ul class="auth-feature-list">
                <li><i class="bi bi-check-circle-fill"></i> Real-time visit queue and status</li>
                <li><i class="bi bi-check-circle-fill"></i> Fast patient check-in and registration</li>
                <li><i class="bi bi-check-circle-fill"></i> Built for busy clinic front desks</li>
            </ul>
        </div>
    </div>
    <div class="auth-form-side">
        <div class="auth-card">
            <div class="mb-4">
                <h1 class="mt-1 mb-1">Welcome back</h1>
                <p class="text-muted mb-0">Sign in to your clinic reception workspace.</p>
            </div>
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="username" placeholder="Enter your username" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="password-field">
                        <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Enter your password" />
                        <button type="button" class="password-toggle" aria-label="Show password" onclick="togglePasswordVisibility(this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <button class="btn btn-primary w-100" type="submit">Sign in <i class="bi bi-arrow-right ms-1"></i></button>
            </form>
            <p class="text-center text-muted mt-4 mb-0">New reception staff? <a asp-action="Register">Create an account</a></p>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
