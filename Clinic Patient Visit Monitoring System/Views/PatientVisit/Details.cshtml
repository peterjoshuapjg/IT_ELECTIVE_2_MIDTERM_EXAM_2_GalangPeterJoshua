@using ClinicPatientVisitMonitoringSystem.Models
@model PatientVisit
@{
    ViewData["Title"] = "Visit Details";
}
<div class="d-flex justify-content-between align-items-start mb-4">
    <div><a asp-action="Index" class="text-decoration-none">← Back to monitoring</a><h1 class="h2 mt-2">Visit Details</h1><p class="text-muted mb-0">@Model.VisitNumber</p></div>
    <span class="status status-@Model.Status.ToLowerInvariant().Replace(" ", "-")">@Model.Status</span>
</div>
<div class="form-card">
    <div class="row g-4">
        <div class="col-md-6"><div class="detail-label">Patient</div><div class="detail-value">@Model.FirstName @Model.LastName</div></div>
        <div class="col-md-3"><div class="detail-label">Age</div><div class="detail-value">@Model.Age</div></div>
        <div class="col-md-3"><div class="detail-label">Sex</div><div class="detail-value">@Model.Sex</div></div>
        <div class="col-md-6"><div class="detail-label">Contact Number</div><div class="detail-value">@Model.ContactNumber</div></div>
        <div class="col-md-6"><div class="detail-label">Address</div><div class="detail-value">@Model.Address</div></div>
        <div class="col-md-4"><div class="detail-label">Physician</div><div class="detail-value">@Model.Physician</div></div>
        <div class="col-md-4"><div class="detail-label">Visit Type</div><div class="detail-value">@Model.VisitType</div></div>
        <div class="col-md-4"><div class="detail-label">Arrival Date & Time</div><div class="detail-value">@Model.ArrivalDateTime.ToString("MMM dd, yyyy hh:mm tt")</div></div>
        <div class="col-md-6"><div class="detail-label">Chief Complaint</div><div class="detail-value">@Model.ChiefComplaint</div></div>
        <div class="col-md-6"><div class="detail-label">Notes</div><div class="detail-value">@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</div></div>
        <div class="col-md-6"><div class="detail-label">Consultation End Time</div><div class="detail-value">@(Model.ConsultationCompletedDateTime?.ToString("MMM dd, yyyy hh:mm tt") ?? "-")</div></div>
    </div>
</div>
<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
    @if (Model.Status == "Waiting")
    {
        <form asp-action="Start" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary" type="submit">Start Consultation</button></form>
    }
    @if (Model.Status != "Completed")
    {
        <a asp-action="Complete" asp-route-id="@Model.Id" class="btn btn-success">Complete Consultation</a>
    }
</div>
