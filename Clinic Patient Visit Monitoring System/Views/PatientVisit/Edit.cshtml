@using ClinicPatientVisitMonitoringSystem.Models
@model PatientVisit
@{
    ViewData["Title"] = "Edit Patient Visit";
}
<div class="page-heading"><a asp-action="Index" class="text-decoration-none">← Back to monitoring</a><h1 class="h2 mt-2">Edit Patient Visit</h1><p class="text-muted">@Model.VisitNumber</p></div>
<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" /><input asp-for="VisitNumber" type="hidden" /><input asp-for="Status" type="hidden" /><input asp-for="ConsultationCompletedDateTime" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="form-card">
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="Age" class="form-label"></label><input asp-for="Age" class="form-control" type="number" /><span asp-validation-for="Age" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="Sex" class="form-label"></label><select asp-for="Sex" class="form-select"><option>Male</option><option>Female</option><option>Other</option></select><span asp-validation-for="Sex" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="ContactNumber" class="form-label"></label><input asp-for="ContactNumber" class="form-control" /><span asp-validation-for="ContactNumber" class="text-danger"></span></div>
            <div class="col-md-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="2"></textarea><span asp-validation-for="Address" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Physician" class="form-label"></label><input asp-for="Physician" class="form-control" /><span asp-validation-for="Physician" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="VisitType" class="form-label"></label><input asp-for="VisitType" class="form-control" /><span asp-validation-for="VisitType" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="ArrivalDateTime" class="form-label"></label><input asp-for="ArrivalDateTime" class="form-control" type="datetime-local" value="@Model.ArrivalDateTime.ToString("yyyy-MM-ddTHH:mm")" /><span asp-validation-for="ArrivalDateTime" class="text-danger"></span></div>
            <div class="col-md-6"><label class="form-label">Status</label><input class="form-control" value="@Model.Status" disabled /></div>
            <div class="col-md-12"><label asp-for="ChiefComplaint" class="form-label"></label><textarea asp-for="ChiefComplaint" class="form-control" rows="3"></textarea><span asp-validation-for="ChiefComplaint" class="text-danger"></span></div>
            <div class="col-md-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea><span asp-validation-for="Notes" class="text-danger"></span></div>
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit">Save Changes</button></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
